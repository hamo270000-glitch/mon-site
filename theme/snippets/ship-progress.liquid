{%- if settings.free_shipping_threshold > 0 -%}
  {%- assign threshold = settings.free_shipping_threshold | times: 100 -%}
  {%- assign remain = threshold | minus: cart.total_price -%}
  {%- assign pct = cart.total_price | times: 100 | divided_by: threshold | at_most: 100 -%}
  <div class="ship-progress" data-ship-progress data-cart-total="{{ cart.total_price }}">
    <div data-ship-text>
      {%- if remain > 0 -%}
        {%- capture remain_money -%}<strong>{{ remain | money }}</strong>{%- endcapture -%}
        {{ 'cart.free_shipping_remaining' | t | replace: '[amount]', remain_money }}
      {%- else -%}
        {{ 'cart.free_shipping_reached' | t }}
      {%- endif -%}
    </div>
    <div class="ship-progress__bar"><span data-ship-bar style="width: {{ pct }}%"></span></div>
  </div>
{%- endif -%}
