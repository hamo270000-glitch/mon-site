<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;1,500&family=Jost:wght@400;500&display=swap" rel="stylesheet">
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>
  <body style="min-height:100vh;display:grid;place-items:center;background:var(--c-cream)">
    <main>{{ content_for_layout }}
      <p style="text-align:center;font-size:.8rem"><a href="{{ routes.root_url }}password" class="link-underline">Accès boutique</a></p>
    </main>
  </body>
</html>
