<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_primary }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

    {% render 'meta-tags' %}

    {{ 'dmsans-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'cormorant-500.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    <style>
      @font-face { font-family: "Cormorant Garamond"; font-weight: 500; font-style: normal; font-display: swap; src: url("{{ 'cormorant-500.woff2' | asset_url }}") format("woff2"); }
      @font-face { font-family: "Cormorant Garamond"; font-weight: 600; font-style: normal; font-display: swap; src: url("{{ 'cormorant-600.woff2' | asset_url }}") format("woff2"); }
      @font-face { font-family: "DM Sans"; font-weight: 400; font-style: normal; font-display: swap; src: url("{{ 'dmsans-400.woff2' | asset_url }}") format("woff2"); }
      @font-face { font-family: "DM Sans"; font-weight: 500; font-style: normal; font-display: swap; src: url("{{ 'dmsans-500.woff2' | asset_url }}") format("woff2"); }
    </style>

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    <style>
      :root {
        --c-primary: {{ settings.color_primary }};
        --c-primary-soft: {{ settings.color_primary_soft }};
        --c-ink: {{ settings.color_ink }};
        --c-bg: {{ settings.color_bg }};
        --c-cream: {{ settings.color_cream }};
        --c-accent: {{ settings.color_accent }};
        --c-sale: {{ settings.color_sale }};
      }
    </style>
    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>

  <body class="template-{{ template.name }}">
    <a class="skip-link" href="#MainContent">{{ 'general.skip' | t }}</a>
    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
    {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
      <div class="drawer" id="CartDrawer" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}">
        <div class="drawer__overlay" data-cart-close></div>
        <div class="drawer__panel">
          <div class="drawer__head">
            <h3>{{ 'cart.title' | t }}</h3>
            <button class="icon-btn" type="button" data-cart-close aria-label="{{ 'general.close' | t }}">{% render 'icon', icon: 'close' %}</button>
          </div>
          {% section 'cart-drawer-content' %}
        </div>
      </div>
    {%- endif -%}

    <script>
      window.theme = {
        routes: {
          cart_add_url: '{{ routes.cart_add_url }}',
          cart_change_url: '{{ routes.cart_change_url }}',
          cart_url: '{{ routes.cart_url }}',
          root: '{{ routes.root_url }}'
        },
        freeShipping: {{ settings.free_shipping_threshold | times: 100 }},
        moneyFormat: {{ shop.money_format | json }},
        strings: {
          added: {{ 'cart.added' | t | json }},
          soldOut: {{ 'product.sold_out' | t | json }},
          addToCart: {{ 'product.add_to_cart' | t | json }},
          freeShippingReached: {{ 'cart.free_shipping_reached' | t | json }},
          freeShippingRemaining: {{ 'cart.free_shipping_remaining' | t | json }}
        }
      };
    </script>
  </body>
</html>
