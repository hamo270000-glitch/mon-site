<section class="section{% if section.settings.cream %} bg-cream{% endif %}">
  <div class="page-width">
    <div class="section-head reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="grid" style="--cols: {{ section.settings.columns }}">
      {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.columns) -%}
          <div class="card"><div class="card__media">{{ 'product-1' | placeholder_svg_tag }}</div><div class="card__info"><span class="card__title">Produit exemple</span><div class="price">29,90 €</div></div></div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if section.settings.collection != blank -%}
      <div style="text-align:center;margin-top:44px"><a class="btn btn--outline" href="{{ section.settings.collection.url }}">{{ 'general.view_all' | t }}</a></div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Collection en vedette",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Nos best-sellers" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Les essentiels de votre rituel" },
    { "type": "text", "id": "text", "label": "Texte" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Nombre de produits", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Colonnes (ordinateur)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "cream", "label": "Fond crème", "default": false }
  ],
  "presets": [{ "name": "Collection en vedette" }]
}
{% endschema %}
