<section class="section{% if section.settings.cream %} bg-cream{% endif %}">
  <div class="page-width section-head reveal" style="margin-bottom:0">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="rte" style="font-size:1.1rem;color:var(--c-muted)">{{ section.settings.text }}</div>
    {%- if section.settings.btn_label != blank -%}<p style="margin-top:28px"><a class="btn btn--outline" href="{{ section.settings.btn_link }}">{{ section.settings.btn_label }}</a></p>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Texte",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Notre histoire" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Votre texte.</p>" },
    { "type": "text", "id": "btn_label", "label": "Bouton" },
    { "type": "url", "id": "btn_link", "label": "Lien" },
    { "type": "checkbox", "id": "cream", "label": "Fond crème", "default": false }
  ],
  "presets": [{ "name": "Texte" }]
}
{% endschema %}
