{{ 'hero-slider.css' | asset_url | stylesheet_tag }}
<section class="hs" data-hs aria-roledescription="carrousel" aria-label="{{ section.settings.label | escape }}">
  <div class="hs__track" data-hs-track>
    {%- for block in section.blocks -%}
      {%- liquid
        assign p = block.settings.product
        assign url = block.settings.link
        if url == blank and p != blank
          assign url = p.url
        endif
        if url == blank
          assign url = routes.all_products_collection_url
        endif
      -%}
      <article class="hs__slide" style="--hs-band: {{ block.settings.band }}; --hs-accent: {{ block.settings.accent }};" aria-roledescription="diapositive" aria-label="{{ forloop.index }} / {{ section.blocks.size }}" {{ block.shopify_attributes }}>
        <a class="hs__media" href="{{ url }}" tabindex="-1" aria-hidden="true">
          {%- if block.settings.image != blank -%}
            {%- if forloop.first -%}{%- assign ld = 'eager' -%}{%- else -%}{%- assign ld = 'lazy' -%}{%- endif -%}
            {{ block.settings.image | image_url: width: 1800 | image_tag: loading: ld, widths: '600, 900, 1200, 1500, 1800', sizes: '(min-width: 990px) 58vw, 100vw', alt: '' }}
          {%- elsif block.settings.image_asset != blank -%}
            <img src="{{ block.settings.image_asset | asset_url }}" alt="" width="1500" height="1250" {% unless forloop.first %}loading="lazy"{% endunless %}>
          {%- endif -%}
        </a>
        <div class="hs__band">
          <div class="hs__text">
            {%- if block.settings.eyebrow != blank -%}<p class="hs__eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
            {%- if forloop.first -%}<h1 class="hs__title">{%- else -%}<h2 class="hs__title">{%- endif -%}
              <span class="hs__hl">{{ block.settings.highlight }}</span> {{ block.settings.title }}
            {%- if forloop.first -%}</h1>{%- else -%}</h2>{%- endif -%}
            <a class="hs__btn" href="{{ url }}">{{ block.settings.button }}</a>
          </div>
        </div>
      </article>
    {%- endfor -%}
  </div>
  {%- if section.blocks.size > 1 -%}
    <div class="hs__dots" role="tablist">
      {%- for block in section.blocks -%}
        <button class="hs__dot{% if forloop.first %} is-active{% endif %}" type="button" role="tab" aria-label="Diapositive {{ forloop.index }}" data-hs-dot="{{ forloop.index0 }}"></button>
      {%- endfor -%}
    </div>
    <button class="hs__arrow hs__arrow--prev" type="button" data-hs-prev aria-label="Précédent">‹</button>
    <button class="hs__arrow hs__arrow--next" type="button" data-hs-next aria-label="Suivant">›</button>
  {%- endif -%}
</section>
<script>
  (function () {
    var root = document.querySelector('[data-hs]'); if (!root) return;
    var track = root.querySelector('[data-hs-track]');
    var slides = track.children, dots = root.querySelectorAll('[data-hs-dot]');
    var i = 0, timer, delay = {{ section.settings.speed | times: 1000 }};
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function go(n, smooth) { if (!slides.length) return; i = (n + slides.length) % slides.length; track.scrollTo({ left: slides[i].offsetLeft, behavior: smooth === false ? 'auto' : 'smooth' }); }
    function mark() { var w = track.clientWidth || 1; var n = Math.round(track.scrollLeft / w); i = n; for (var k = 0; k < dots.length; k++) dots[k].classList.toggle('is-active', k === n); }
    function play() { if (reduce || !{{ section.settings.autoplay | json }}) return; stop(); timer = setInterval(function () { go(i + 1); }, delay); }
    function stop() { clearInterval(timer); }
    var t; track.addEventListener('scroll', function () { clearTimeout(t); t = setTimeout(mark, 60); }, { passive: true });
    for (var k = 0; k < dots.length; k++) dots[k].addEventListener('click', (function (n) { return function () { go(n); play(); }; })(k));
    var p = root.querySelector('[data-hs-prev]'), nx = root.querySelector('[data-hs-next]');
    p && p.addEventListener('click', function () { go(i - 1); play(); });
    nx && nx.addEventListener('click', function () { go(i + 1); play(); });
    root.addEventListener('mouseenter', stop); root.addEventListener('mouseleave', play);
    track.addEventListener('touchstart', stop, { passive: true }); track.addEventListener('touchend', play, { passive: true });
    play();
  })();
</script>
{% schema %}
{
  "name": "Carrousel d'accueil",
  "settings": [
    { "type": "text", "id": "label", "label": "Nom accessible", "default": "Nos produits" },
    { "type": "checkbox", "id": "autoplay", "label": "Défilement automatique", "default": true },
    { "type": "range", "id": "speed", "label": "Durée par diapositive", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 6 }
  ],
  "max_blocks": 6,
  "blocks": [{ "type": "slide", "name": "Diapositive", "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (idéalement une personne qui applique le produit)" },
    { "type": "text", "id": "image_asset", "label": "Ou image du thème (fichier assets)" },
    { "type": "product", "id": "product", "label": "Produit" },
    { "type": "text", "id": "eyebrow", "label": "Petit titre", "default": "Nouveau" },
    { "type": "text", "id": "highlight", "label": "Mot(s) en couleur", "default": "Éclat" },
    { "type": "text", "id": "title", "label": "Suite du titre", "default": "immédiat" },
    { "type": "text", "id": "button", "label": "Bouton", "default": "Découvrir" },
    { "type": "url", "id": "link", "label": "Lien (vide = produit)" },
    { "type": "color", "id": "band", "label": "Couleur du bandeau", "default": "#E3F1EE" },
    { "type": "color", "id": "accent", "label": "Couleur du mot en couleur", "default": "#0E7C7B" }
  ] }],
  "presets": [{ "name": "Carrousel d'accueil", "blocks": [{ "type": "slide" }, { "type": "slide" }] }]
}
{% endschema %}
