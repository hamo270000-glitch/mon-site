{{ 'product.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign mf = product.metafields.custom
-%}
<div class="page-width" data-product-section>
  <nav class="breadcrumbs" aria-label="Fil d'Ariane">
    <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span class="bc-sep">›</span>
    <a href="{{ routes.all_products_collection_url }}">Produits</a><span class="bc-sep">›</span>
    {% if collection and collection.handle != 'all' %}<a href="{{ collection.url }}">{{ collection.title }}</a><span class="bc-sep">›</span>{% elsif product.type != blank %}<span>{{ product.type }}</span><span class="bc-sep">›</span>{% endif %}
    <span>{{ product.title }}</span>
  </nav>

  <div class="product">
    {%- comment -%} Galerie photos + vidéos {%- endcomment -%}
    <div class="gallery" data-gallery>
      <div class="gallery__thumbs">
        {%- for media in product.media -%}
          <button class="gallery__thumb{% if forloop.first %} is-active{% endif %}" type="button" data-media-id="{{ media.id }}" aria-label="Média {{ forloop.index }}">
            {{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '' }}
            {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}<span class="play">{% render 'icon', icon: 'play' %}</span>{%- endif -%}
          </button>
        {%- endfor -%}
      </div>
      <div class="gallery__main" data-gallery-track>
        {%- if product.tags contains 'edition-limitee' -%}<span class="gallery__badge">Édition limitée</span>{%- elsif product.tags contains 'nouveau' -%}<span class="gallery__badge">Nouveau</span>{%- elsif product.tags contains 'best-seller' -%}<span class="gallery__badge">Best-seller</span>{%- endif -%}
        {%- for media in product.media -%}
          <div class="gallery__slide{% if forloop.first %} is-active{% endif %}">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {%- if forloop.first -%}{%- assign ld = 'eager' -%}{%- else -%}{%- assign ld = 'lazy' -%}{%- endif -%}
                {{ media | image_url: width: 1600 | image_tag: loading: ld, widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 55vw, 100vw', alt: media.alt | default: product.title }}
              {%- when 'video' -%}
                {{ media | video_tag: autoplay: forloop.first, loop: true, muted: true, playsinline: true, controls: true, image_size: '1200x' }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag }}
              {%- else -%}
                {{ media | media_tag }}
            {%- endcase -%}
          </div>
        {%- else -%}
          <div class="gallery__slide is-active">{{ 'product-1' | placeholder_svg_tag }}</div>
        {%- endfor -%}
      </div>
      {%- if product.media.size > 1 -%}<button class="gallery__next" type="button" data-gallery-next aria-label="Photo suivante">→</button>{%- endif -%}
    </div>

    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
          {%- when 'title' -%}
            <div {{ block.shopify_attributes }}>
              {%- assign range = mf.range | default: product.type -%}
              {%- if range != blank -%}<p class="product__range">{{ range }}</p>{%- endif -%}
              <h1 class="product__title">{{ product.title }}</h1>
            </div>
            {%- if mf.subtitle != blank -%}<p class="product__subtitle">{{ mf.subtitle }}</p>{%- endif -%}
          {%- when 'rating' -%}
            <div class="product__meta-row" {{ block.shopify_attributes }}>
              <div class="product__rating">
                {%- assign rv = product.metafields.reviews.rating.value -%}
                {%- assign rc = product.metafields.reviews.rating_count.value | default: 0 -%}
                {%- if rv != blank and rc > 0 -%}
                  {%- assign pct = rv.rating | divided_by: rv.scale_max | times: 100 -%}
                  <a href="#avis" class="product__stars"><span class="stars__icons" style="--pct: {{ pct }}%"></span><span>{{ rc }}</span></a>
                  <span class="product__sep">|</span>
                {%- endif -%}
                <a href="#avis" class="product__review-link">{{ 'product.write_review' | t }}</a>
              </div>
              {%- if mf.volume != blank -%}<span class="chip">{{ mf.volume }}</span>{%- endif -%}
            </div>
          {%- when 'price' -%}
            <div {{ block.shopify_attributes }}>
              {% render 'price', product: product, variant: current_variant, large: true %}
              {%- if block.settings.installments -%}
                {%- assign third = current_variant.price | divided_by: 3 -%}
                <p class="installments" style="margin:6px 0 0">{{ 'product.installments' | t }} <strong>3 × {{ third | money }}</strong> sans frais {{ block.settings.installments_provider }}</p>
              {%- endif -%}
              <small style="color:var(--c-muted)">{{ 'product.taxes' | t }}</small>
            </div>
          {%- when 'skin' -%}
            {%- if mf.skin_types != blank -%}
              <div class="tags-row" {{ block.shopify_attributes }}>
                {%- assign items = mf.skin_types.value | newline_to_br | split: '<br />' -%}
                {%- for t in items -%}<span class="chip">{{ t | strip }}</span>{%- endfor -%}
              </div>
            {%- endif -%}
          {%- when 'text' -%}
            <div class="rte" style="color:var(--c-muted)" {{ block.shopify_attributes }}>{{ block.settings.text | default: mf.short_description }}</div>
          {%- when 'benefits' -%}
            {%- if mf.benefits != blank -%}
              <div class="benefits-grid" {{ block.shopify_attributes }}>
                {%- assign items = mf.benefits.value | newline_to_br | split: '<br />' -%}
                {%- for b in items -%}<span class="benefit">{{ b | strip }}</span>{%- endfor -%}
              </div>
            {%- endif -%}
          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="variant-picker" data-variant-picker {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  <fieldset>
                    <legend>{{ option.name }}</legend>
                    <div class="pills">
                      {%- for value in option.values -%}
                        <input type="radio" id="opt-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}" name="option-{{ option.position }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                        <label for="opt-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}">{{ value }}</label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
                <script type="application/json">{{ product.variants | json }}</script>
              </div>
            {%- endunless -%}
          {%- when 'buy_buttons' -%}
            <div {{ block.shopify_attributes }} data-main-atc>
              {%- form 'product', product, data-product-form: '' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">
                <div class="buy-row">
                  <div class="qty" data-qty>
                    <button type="button" data-qty-minus aria-label="-">−</button>
                    <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'product.quantity' | t }}">
                    <button type="button" data-qty-plus aria-label="+">+</button>
                  </div>
                  <button class="btn btn--primary" type="submit" data-atc{% unless current_variant.available %} disabled{% endunless %}>
                    <span>{%- if current_variant.available -%}{{ 'product.add_to_cart' | t }}{%- else -%}{{ 'product.sold_out' | t }}{%- endif -%}</span>
                  </button>
                </div>
                {%- if block.settings.express_button -%}
                  <button class="btn-express" type="button" data-buy-now{% unless current_variant.available %} disabled{% endunless %}>
                    <span class="btn-express__apple" data-applepay hidden aria-label="Payer avec Apple Pay">
                      <svg viewBox="0 0 17 20" aria-hidden="true"><path fill="#fff" d="M14.06 10.62c-.02-2.1 1.72-3.12 1.8-3.17-.98-1.43-2.5-1.63-3.04-1.65-1.29-.13-2.53.76-3.18.76-.66 0-1.67-.74-2.75-.72-1.41.02-2.72.82-3.45 2.09-1.47 2.55-.38 6.33 1.06 8.4.7 1.01 1.53 2.15 2.62 2.11 1.05-.04 1.45-.68 2.72-.68 1.27 0 1.63.68 2.74.66 1.13-.02 1.85-1.03 2.54-2.05.8-1.17 1.13-2.31 1.15-2.37-.03-.01-2.2-.84-2.21-3.38ZM11.98 4.44c.58-.7.97-1.68.86-2.65-.83.03-1.84.55-2.44 1.25-.54.62-1.01 1.61-.88 2.56.93.07 1.88-.47 2.46-1.16Z"/></svg>
                      <span>Pay</span>
                    </span>
                    <span class="btn-express__generic" data-buynow-label>{{ 'product.buy_now' | t }}</span>
                  </button>
                {%- endif -%}
                {%- if block.settings.dynamic_checkout -%}<div style="margin-top:12px">{{ form | payment_button }}</div>{%- endif -%}
              {%- endform -%}
              {%- if block.settings.show_stock and current_variant.inventory_management == 'shopify' -%}
                {%- assign qty = current_variant.inventory_quantity -%}
                <div class="stock{% if qty <= block.settings.low_stock and qty > 0 %} stock--low{% endif %}" style="margin-top:14px">
                  <span class="stock__dot"></span>
                  {%- if qty <= 0 and current_variant.available -%}{{ 'product.preorder' | t }}
                  {%- elsif qty <= block.settings.low_stock -%}{{ 'product.low_stock' | t: count: qty }}
                  {%- else -%}{{ 'product.in_stock' | t }}{%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- when 'delivery' -%}
            {%- assign d1 = 'now' | date: '%s' | plus: 172800 | date: '%d/%m' -%}
            {%- assign d2 = 'now' | date: '%s' | plus: 345600 | date: '%d/%m' -%}
            <div class="delivery" {{ block.shopify_attributes }}>
              <div>{% render 'icon', icon: 'truck' %}<span>{{ 'product.delivery_estimate' | t }} <strong>{{ d1 }} – {{ d2 }}</strong></span></div>
              <div>{% render 'icon', icon: 'gift' %}<span>{{ settings.trust_shipping }}</span></div>
              <div>{% render 'icon', icon: 'return' %}<span>{{ settings.trust_returns }}</span></div>
            </div>
          {%- when 'complementary' -%}
            {%- assign pairs = mf.complementary.value -%}
            {%- if pairs != blank and pairs.count > 0 -%}
              <div class="pairs" {{ block.shopify_attributes }}>
                <h4>{{ block.settings.heading }}</h4>
                {%- for p in pairs limit: 3 -%}
                  <div class="pair">
                    <a href="{{ p.url }}">{{ p.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: p.title }}</a>
                    <div><a href="{{ p.url }}" style="font-family:var(--f-serif);font-size:1.1rem">{{ p.title }}</a>{% render 'price', product: p, large: false %}</div>
                    {%- if p.available -%}<button class="btn btn--outline" type="button" data-quick-add="{{ p.selected_or_first_available_variant.id }}">+ {{ 'product.add' | t }}</button>{%- endif -%}
                  </div>
                {%- endfor -%}
              </div>
            {%- endif -%}
          {%- when 'specs' -%}
            <dl class="specs" {{ block.shopify_attributes }}>
              {%- if mf.skin_types != blank -%}
                {%- assign items = mf.skin_types.value | newline_to_br | split: '<br />' -%}
                <div><dt>Type de peau :</dt> <dd>{% for t in items %}{{ t | strip }}{% unless forloop.last %}, {% endunless %}{% endfor %}</dd></div>
              {%- endif -%}
              {%- if mf.concerns != blank -%}
                {%- assign items = mf.concerns.value | newline_to_br | split: '<br />' -%}
                <div><dt>Besoin :</dt> <dd>{% for t in items %}{{ t | strip }}{% unless forloop.last %}, {% endunless %}{% endfor %}</dd></div>
              {%- endif -%}
              {%- if mf.key_ingredients != blank -%}
                {%- assign items = mf.key_ingredients.value | newline_to_br | split: '<br />' -%}
                <div><dt>Ingrédients clés :</dt> <dd>{% for t in items %}{{ t | split: ' — ' | first | strip_html | strip }}{% unless forloop.last %}, {% endunless %}{% endfor %}</dd></div>
              {%- endif -%}
              {%- if mf.usage != blank -%}<div><dt>Utilisation :</dt> <dd>{{ mf.usage }}</dd></div>{%- endif -%}
              {%- if product.description != blank -%}
                <div class="specs__desc" data-clamp>
                  <dt>Description</dt>
                  <dd class="specs__clamp">{{ product.description | strip_html | truncatewords: 80 }}</dd>
                  <button class="specs__more" type="button" data-clamp-toggle>Voir plus</button>
                </div>
              {%- endif -%}
            </dl>
          {%- when 'labels' -%}
            <div class="stamps" {{ block.shopify_attributes }}>
              {%- for i in (1..3) -%}
                {%- assign key = 'label_' | append: i -%}
                {%- assign txt = block.settings[key] -%}
                {%- if txt != blank -%}
                  {%- assign parts = txt | split: '|' -%}
                  <span class="stamp">
                    {%- if parts.size > 1 -%}
                      <svg viewBox="0 0 100 100" aria-hidden="true"><defs><path id="st{{ i }}{{ block.id }}" d="M50,50 m-36,0 a36,36 0 1,1 72,0 a36,36 0 1,1 -72,0"/></defs><text><textPath href="#st{{ i }}{{ block.id }}" startOffset="0">{{ parts[1] | strip | upcase }}</textPath></text></svg>
                    {%- endif -%}
                    <strong>{{ parts[0] | strip }}</strong>
                  </span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- when 'collapsible' -%}
            {%- liquid
              assign content = blank
              case block.settings.source
                when 'description'
                  assign content = product.description
                when 'ingredients'
                  capture content
                    if mf.key_ingredients != blank
                      assign items = mf.key_ingredients.value | newline_to_br | split: '<br />'
                      echo '<ul>'
                      for t in items
                        assign kv = t | split: ' — '
                        echo '<li><strong>' | append: kv[0] | append: '</strong>'
                        if kv[1]
                          echo ' : ' | append: kv[1]
                        endif
                        echo '</li>'
                      endfor
                      echo '</ul>'
                    endif
                    if mf.inci != blank
                      echo '<p class="inci-title"><strong>Liste complète d’ingrédients :</strong></p><p class="inci">' | append: mf.inci.value | append: '</p>'
                    endif
                  endcapture
                when 'inci'
                  assign content = mf.inci.value | newline_to_br
                when 'how_to_use'
                  assign content = mf.how_to_use.value | newline_to_br
                when 'custom'
                  assign content = block.settings.content
                when 'page'
                  assign content = block.settings.page.content
              endcase
            -%}
            {%- if content != blank -%}
              <div class="accordion accordion--box" {{ block.shopify_attributes }}>
                <details{% if block.settings.open %} open{% endif %}>
                  <summary>{{ block.settings.heading }}</summary>
                  <div class="rte">{{ content }}</div>
                </details>
              </div>
            {%- endif -%}
          {%- when 'trust' -%}
            <div class="trust__grid" style="grid-template-columns:1fr 1fr;padding:6px 0" {{ block.shopify_attributes }}>
              <div class="trust__item">{% render 'icon', icon: 'flag' %}<div><strong>Marque française</strong></div></div>
              <div class="trust__item">{% render 'icon', icon: 'lock' %}<div><strong>Paiement sécurisé</strong></div></div>
              <div class="trust__item">{% render 'icon', icon: 'rabbit' %}<div><strong>Non testé sur les animaux</strong></div></div>
              <div class="trust__item">{% render 'icon', icon: 'return' %}<div><strong>Retours 30 jours</strong></div></div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.settings.sticky_atc and current_variant.available -%}
  <div class="sticky-atc" data-sticky-atc>
    <div class="page-width sticky-atc__inner">
      {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 120 | image_tag: alt: '' }}{%- endif -%}
      <span class="sticky-atc__title">{{ product.title }}</span>
      {% render 'price', product: product, variant: current_variant, large: false %}
      <button class="btn btn--primary" type="button">{{ 'product.add_to_cart' | t }}</button>
    </div>
  </div>
{%- endif -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "image": [{% for img in product.images limit: 6 %}{{ img | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
  "description": {{ product.description | strip_html | json }},
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  {%- if current_variant.sku != blank -%}"sku": {{ current_variant.sku | json }},{%- endif -%}
  {%- assign r = product.metafields.reviews.rating.value -%}
  {%- assign rc = product.metafields.reviews.rating_count.value -%}
  {%- if r != blank and rc > 0 -%}
  "aggregateRating": { "@type": "AggregateRating", "ratingValue": {{ r.rating | json }}, "bestRating": {{ r.scale_max | json }}, "reviewCount": {{ rc | json }} },
  {%- endif -%}
  "offers": [{%- for v in product.variants -%}{
    "@type": "Offer",
    "price": {{ v.price | divided_by: 100.0 | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
    "url": "{{ request.origin }}{{ v.url }}"
  }{% unless forloop.last %},{% endunless %}{%- endfor -%}]
}
</script>

{% schema %}
{
  "name": "Fiche produit",
  "settings": [
    { "type": "checkbox", "id": "sticky_atc", "label": "Barre d'achat collante", "default": true }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "title", "name": "Titre", "limit": 1 },
    { "type": "rating", "name": "Note & format", "limit": 1 },
    { "type": "price", "name": "Prix", "limit": 1, "settings": [
      { "type": "checkbox", "id": "installments", "label": "Afficher le paiement en 3x", "default": true },
      { "type": "text", "id": "installments_provider", "label": "Prestataire", "default": "avec Klarna", "info": "Activez réellement le service (Klarna, Alma, PayPal 4x) avant de l'afficher." }
    ] },
    { "type": "skin", "name": "Types de peau", "limit": 1 },
    { "type": "text", "name": "Texte", "settings": [{ "type": "richtext", "id": "text", "label": "Texte (vide = description courte du métachamp)" }] },
    { "type": "benefits", "name": "Bénéfices", "limit": 1 },
    { "type": "variant_picker", "name": "Variantes", "limit": 1 },
    { "type": "buy_buttons", "name": "Boutons d'achat", "limit": 1, "settings": [
      { "type": "checkbox", "id": "express_button", "label": "Bouton noir « Apple Pay / Acheter maintenant »", "default": true, "info": "Affiche « Apple Pay » sur iPhone/Mac (si activé dans Shopify Payments), sinon « Acheter maintenant ». Mène directement au paiement." },
      { "type": "checkbox", "id": "dynamic_checkout", "label": "Boutons de paiement Shopify (Shop Pay…)", "default": false },
      { "type": "checkbox", "id": "show_stock", "label": "Indicateur de stock (réel)", "default": true },
      { "type": "range", "id": "low_stock", "label": "Seuil de stock faible", "min": 1, "max": 30, "step": 1, "default": 10 }
    ] },
    { "type": "delivery", "name": "Livraison estimée", "limit": 1 },
    { "type": "complementary", "name": "Complétez votre rituel", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Titre", "default": "Complétez votre rituel" }
    ] },
    { "type": "collapsible", "name": "Onglet dépliable", "settings": [
      { "type": "text", "id": "heading", "label": "Titre", "default": "Description" },
      { "type": "select", "id": "source", "label": "Contenu", "default": "description", "options": [
        { "value": "description", "label": "Description du produit" },
        { "value": "ingredients", "label": "Nos ingrédients (actifs + INCI)" },
        { "value": "inci", "label": "Métachamp : liste INCI" },
        { "value": "how_to_use", "label": "Métachamp : mode d'emploi" },
        { "value": "page", "label": "Page" },
        { "value": "custom", "label": "Texte personnalisé" } ] },
      { "type": "page", "id": "page", "label": "Page" },
      { "type": "richtext", "id": "content", "label": "Texte personnalisé" },
      { "type": "checkbox", "id": "open", "label": "Ouvert par défaut", "default": false }
    ] },
    { "type": "trust", "name": "Réassurance", "limit": 1 },
    { "type": "specs", "name": "Caractéristiques", "limit": 1 },
    { "type": "labels", "name": "Pastilles rondes", "limit": 1, "settings": [
      { "type": "text", "id": "label_1", "label": "Pastille 1 (texte | texte circulaire)", "default": "Paris | Conçue à Paris ·" },
      { "type": "text", "id": "label_2", "label": "Pastille 2", "default": "30 j | Retours offerts ·" },
      { "type": "text", "id": "label_3", "label": "Pastille 3", "info": "N'affichez que des mentions vraies (ex : vegan si certifié)." }
    ] }
  ]
}
{% endschema %}
