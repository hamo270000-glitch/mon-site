<section class="section">
  <div class="page-width">
    <div class="section-head">
      <h1>{{ 'search.title' | t }}</h1>
      <form action="{{ routes.search_url }}" method="get" style="display:flex;gap:10px;max-width:560px;margin:0 auto">
        <input class="field" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
        <input type="hidden" name="type" value="product">
        <button class="btn" type="submit">{{ 'general.search' | t }}</button>
      </form>
    </div>
    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        <p style="text-align:center;color:var(--c-muted)">{{ 'search.results' | t: count: search.results_count, terms: search.terms }}</p>
        <div class="grid" style="--cols:4">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}
            {%- else -%}<div class="card"><a class="card__title" href="{{ item.url }}">{{ item.title }}</a></div>{%- endif -%}
          {%- endfor -%}
        </div>
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Recherche" }
{% endschema %}
