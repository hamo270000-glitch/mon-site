<section class="section{% if section.settings.cream %} bg-cream{% endif %}">
  <div class="page-width">
    <div class="section-head reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="steps" style="--cols: {{ section.blocks.size | at_most: 4 }}">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <div class="step reveal" data-tilt="6" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
          {%- elsif p != blank and p.featured_image -%}
            {{ p.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: p.title }}
          {%- elsif block.settings.image_asset != blank -%}
            <img src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="600" height="600">
          {%- endif -%}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
          {%- if p != blank -%}<p style="margin-top:14px"><a class="link-underline" href="{{ p.url }}">{{ p.title }}, {{ p.price | money }}</a></p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.btn_label != blank -%}<div style="text-align:center;margin-top:44px"><a class="btn btn--primary" href="{{ section.settings.btn_link }}">{{ section.settings.btn_label }}</a></div>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Routine en étapes",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Votre rituel" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "La routine éclat en 4 gestes" },
    { "type": "text", "id": "text", "label": "Texte" },
    { "type": "text", "id": "btn_label", "label": "Bouton", "default": "Composer ma routine" },
    { "type": "url", "id": "btn_link", "label": "Lien" },
    { "type": "checkbox", "id": "cream", "label": "Fond crème", "default": true }
  ],
  "max_blocks": 4,
  "blocks": [{ "type": "step", "name": "Étape", "settings": [
    { "type": "product", "id": "product", "label": "Produit associé" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_asset", "label": "Image du thème (fichier assets)" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Nettoyer" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Description de l'étape." }
  ] }],
  "presets": [{ "name": "Routine en étapes" }]
}
{% endschema %}
