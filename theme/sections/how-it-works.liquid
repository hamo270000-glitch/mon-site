{%- liquid
  assign show = true
  if section.settings.required_tag != blank and product
    unless product.tags contains section.settings.required_tag
      assign show = false
    endunless
  endif
-%}
{%- if show -%}
<section id="le-geste" class="section howto{% if section.settings.cream %} bg-cream{% endif %}">
  <div class="page-width howto__grid">
    <div class="howto__visual reveal">
      <svg class="facemap" viewBox="0 0 300 360" role="img" aria-label="Sens du massage : du centre du visage vers l'extérieur, puis vers le cou">
        <defs>
          <linearGradient id="fmG" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8A6A45"/><stop offset="1" stop-color="#8A6A45"/></linearGradient>
          <marker id="fmA" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#8A6A45"/></marker>
        </defs>
        <path class="facemap__line" d="M150 28c-52 0-88 40-88 100 0 46 14 86 34 112 16 21 34 32 54 32s38-11 54-32c20-26 34-66 34-112 0-60-36-100-88-100Z"/>
        <path class="facemap__line" d="M108 272c-4 22-10 40-22 58M192 272c4 22 10 40 22 58"/>
        <path class="facemap__soft" d="M104 140c10-8 22-8 32 0M164 140c10-8 22-8 32 0M150 150v40c-4 6-10 8-14 6M132 222c12 8 24 8 36 0"/>
        <g class="facemap__arrows" stroke="url(#fmG)" marker-end="url(#fmA)">
          <path d="M140 92c-16-6-34-4-50 8"/><path d="M160 92c16-6 34-4 50 8"/>
          <path d="M126 172c-14 0-28 4-40 12"/><path d="M174 172c14 0 28 4 40 12"/>
          <path d="M136 246c-14 2-30-4-42-16"/><path d="M164 246c14 2 30-4 42-16"/>
          <path d="M150 284v44"/>
        </g>
      </svg>
      {%- if section.settings.image != blank -%}
        <div class="howto__photo">{{ section.settings.image | image_url: width: 500 | image_tag: loading: 'lazy' }}</div>
      {%- elsif section.settings.image_asset != blank -%}
        <div class="howto__photo"><img src="{{ section.settings.image_asset | asset_url }}" alt="" loading="lazy" width="500" height="500"></div>
      {%- endif -%}
    </div>
    <div class="reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <ol class="howto__steps">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><span class="howto__n">{{ forloop.index }}</span><div><strong>{{ block.settings.title }}</strong><p>{{ block.settings.text }}</p></div></li>
        {%- endfor -%}
      </ol>
      {%- if section.settings.btn_label != blank -%}<a class="btn btn--primary" href="{{ section.settings.btn_link }}">{{ section.settings.btn_label }}</a>{%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Le geste en étapes",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Le geste" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "3 minutes, 3 mouvements" },
    { "type": "image_picker", "id": "image", "label": "Photo du geste (bulle)" },
    { "type": "text", "id": "image_asset", "label": "Ou image du thème (fichier assets)", "default": "brosse-geste-rond.webp" },
    { "type": "text", "id": "btn_label", "label": "Bouton" },
    { "type": "url", "id": "btn_link", "label": "Lien" },
    { "type": "checkbox", "id": "cream", "label": "Fond crème", "default": false },
    { "type": "text", "id": "required_tag", "label": "Sur une fiche produit : afficher seulement si le produit a ce tag", "info": "Ex : drainage" }
  ],
  "max_blocks": 4,
  "blocks": [{ "type": "step", "name": "Étape", "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Étape" },
    { "type": "text", "id": "text", "label": "Texte (court)" }
  ] }],
  "presets": [{ "name": "Le geste en étapes", "blocks": [
    { "type": "step", "settings": { "title": "Préparez", "text": "Deux gouttes d'huile sur peau propre." } },
    { "type": "step", "settings": { "title": "Lissez", "text": "Du centre du visage vers les oreilles." } },
    { "type": "step", "settings": { "title": "Drainez", "text": "Descendez le long du cou." } }
  ] }]
}
{% endschema %}
