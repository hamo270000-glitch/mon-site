<section class="section{% if section.settings.bg == 'cream' %} bg-cream{% elsif section.settings.bg == 'soft' %} bg-soft{% endif %}">
  <div class="page-width iwt{% if section.settings.reverse %} iwt--reverse{% endif %}">
    <div class="iwt__media reveal" data-tilt="4">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true }}
      {%- elsif section.settings.video_asset != blank -%}
        <video autoplay muted loop playsinline><source src="{{ section.settings.video_asset | asset_url }}" type="video/mp4"></video>
      {%- elsif section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 750px) 50vw, 100vw' }}
      {%- elsif section.settings.image_asset != blank -%}
        <img src="{{ section.settings.image_asset | asset_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy" width="1400" height="1400">
      {%- else -%}
        {{ 'image' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    <div class="reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <div class="rte" style="color:var(--c-muted)">{{ section.settings.text }}</div>
      {%- assign bullets = section.blocks | where: 'type', 'bullet' -%}
      {%- if bullets.size > 0 -%}
        <ul class="iwt__list">{%- for block in bullets -%}<li {{ block.shopify_attributes }}><span><strong>{{ block.settings.title }}</strong>{% if block.settings.text != blank %} — {{ block.settings.text }}{% endif %}</span></li>{%- endfor -%}</ul>
      {%- endif -%}
      {%- assign stats = section.blocks | where: 'type', 'stat' -%}
      {%- if stats.size > 0 -%}
        <div class="stat-row">{%- for block in stats -%}<div class="stat" {{ block.shopify_attributes }}><strong>{{ block.settings.value }}</strong><span>{{ block.settings.label }}</span></div>{%- endfor -%}</div>
      {%- endif -%}
      {%- if section.settings.btn_label != blank -%}<a class="btn" href="{{ section.settings.btn_link }}">{{ section.settings.btn_label }}</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Image avec texte",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_asset", "label": "Image du thème (fichier assets)" },
    { "type": "video", "id": "video", "label": "Vidéo (Shopify)" },
    { "type": "text", "id": "video_asset", "label": "Vidéo du thème (fichier assets)" },
    { "type": "checkbox", "id": "reverse", "label": "Image à droite", "default": false },
    { "type": "select", "id": "bg", "label": "Fond", "default": "none", "options": [{ "value": "none", "label": "Blanc" }, { "value": "cream", "label": "Crème" }, { "value": "soft", "label": "Lavande" }] },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Le produit phare" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "La brosse lymphatique visage" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Un geste de massage drainant inspiré des rituels de beauté traditionnels.</p>" },
    { "type": "text", "id": "btn_label", "label": "Bouton", "default": "Découvrir" },
    { "type": "url", "id": "btn_link", "label": "Lien" }
  ],
  "blocks": [
    { "type": "bullet", "name": "Point clé", "settings": [
      { "type": "text", "id": "title", "label": "Titre", "default": "Bénéfice" },
      { "type": "text", "id": "text", "label": "Texte" } ] },
    { "type": "stat", "name": "Chiffre", "limit": 3, "settings": [
      { "type": "text", "id": "value", "label": "Valeur", "default": "100 %" },
      { "type": "text", "id": "label", "label": "Libellé", "info": "N'utilisez que des chiffres réels et vérifiables.", "default": "bois naturel" } ] }
  ],
  "presets": [{ "name": "Image avec texte" }]
}
{% endschema %}
