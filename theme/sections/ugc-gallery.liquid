<section class="section">
  <div class="page-width">
    <div class="section-head reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="ugc">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: section.settings.profile }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy' }}
          {%- elsif block.settings.image_asset != blank -%}
            <img src="{{ block.settings.image_asset | asset_url }}" alt="" loading="lazy" width="500" height="500">
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Galerie Instagram",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "@biovelaparis" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Rejoignez la communauté" },
    { "type": "text", "id": "text", "label": "Texte", "default": "Partagez votre rituel avec #biovelaparis" },
    { "type": "url", "id": "profile", "label": "Lien du profil" }
  ],
  "max_blocks": 12,
  "blocks": [{ "type": "image", "name": "Image", "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_asset", "label": "Image du thème (fichier assets)" },
    { "type": "url", "id": "link", "label": "Lien" }
  ] }],
  "presets": [{ "name": "Galerie Instagram" }]
}
{% endschema %}
