{%- paginate blog.articles by 9 -%}
<section class="section">
  <div class="page-width">
    <div class="section-head"><span class="eyebrow">Le Journal</span><h1>{{ blog.title }}</h1></div>
    <div class="grid" style="--cols:3">
      {%- for article in blog.articles -%}
        <a class="reveal" href="{{ article.url }}">
          <div class="article-card__img">{%- if article.image -%}{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy' }}{%- endif -%}</div>
          <small style="color:var(--c-muted)">{{ article.published_at | date: '%d/%m/%Y' }}</small>
          <h3 style="margin-top:6px">{{ article.title }}</h3>
          <p style="color:var(--c-muted)">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endpaginate -%}
{% schema %}
{ "name": "Blog" }
{% endschema %}
