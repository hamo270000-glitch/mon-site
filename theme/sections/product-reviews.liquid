{%- comment -%}
  Avis du produit. Les étoiles et la note viennent automatiquement de votre application d'avis
  (Judge.me, Avis Vérifiés, Okendo…) via les métachamps reviews.*. Ajoutez le bloc de l'application
  pour afficher la liste complète des avis avec photos et vidéos.
{%- endcomment -%}
{%- liquid
  assign r = product.metafields.reviews.rating.value
  assign c = product.metafields.reviews.rating_count.value | default: 0
  assign score = section.settings.score
  assign count_label = section.settings.count_label
  if r != blank and c > 0
    assign score = r.rating | round: 1
    assign count_label = c | append: ' avis'
  endif
-%}
<section class="section reviews-x" id="avis">
  <div class="page-width">
    <div class="reviews-x__head">
      <div>
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if score != blank -%}
        {%- assign pct = score | replace: ',', '.' | times: 20 -%}
        <div class="reviews-x__score">
          <strong>{{ score }}</strong>
          <div><span class="stars__icons" style="--pct: {{ pct }}%"></span><small>{{ count_label }}</small></div>
        </div>
      {%- endif -%}
    </div>

    <div class="reviews-x__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            <div class="reviews-x__app">{% render block %}</div>
          {%- when 'review' -%}
            {%- assign pct = block.settings.rating | times: 20 -%}
            <article class="rx" {{ block.shopify_attributes }}>
              {%- if block.settings.photo != blank -%}
                <div class="rx__photo">{{ block.settings.photo | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.name }}</div>
              {%- elsif block.settings.photo_asset != blank -%}
                <div class="rx__photo"><img src="{{ block.settings.photo_asset | asset_url }}" alt="" loading="lazy" width="600" height="600"></div>
              {%- endif -%}
              <div class="rx__body">
                {%- if block.settings.is_example -%}<span class="review__example">Exemple — à remplacer</span>{%- endif -%}
                <span class="stars__icons" style="--pct: {{ pct }}%"></span>
                <p class="rx__text">{{ block.settings.text }}</p>
                <span class="rx__name">{{ block.settings.name }}{% if block.settings.verified %} · <span class="review__verified">Achat vérifié</span>{% endif %}</span>
              </div>
            </article>
        {%- endcase -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.write_link != blank -%}
      <p style="text-align:center;margin-top:36px"><a class="btn btn--outline" href="{{ section.settings.write_link }}">{{ 'product.write_review' | t }}</a></p>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Avis produit",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Avis clients" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ce qu'elles en disent" },
    { "type": "text", "id": "score", "label": "Note affichée sans application (ex : 4,8)", "info": "Ignoré dès qu'une application d'avis est installée. N'indiquez qu'une note réelle." },
    { "type": "text", "id": "count_label", "label": "Libellé nombre d'avis", "default": "avis vérifiés" },
    { "type": "url", "id": "write_link", "label": "Lien « Laisser un avis »" }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "review", "name": "Avis avec photo", "settings": [
      { "type": "image_picker", "id": "photo", "label": "Photo cliente (avec son accord)" },
      { "type": "text", "id": "photo_asset", "label": "Ou image du thème (fichier assets)" },
      { "type": "range", "id": "rating", "label": "Note", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "textarea", "id": "text", "label": "Avis (court)", "default": "Collez ici un avis client réel." },
      { "type": "text", "id": "name", "label": "Prénom + initiale", "default": "Prénom N." },
      { "type": "checkbox", "id": "verified", "label": "Achat vérifié", "default": false },
      { "type": "checkbox", "id": "is_example", "label": "Afficher « Exemple »", "default": true }
    ] }
  ],
  "presets": [{ "name": "Avis produit" }]
}
{% endschema %}
