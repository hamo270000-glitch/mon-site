{{ 'hero.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign p = section.settings.product
  assign url = section.settings.btn1_link
  if url == blank and p != blank
    assign url = p.url
  endif
-%}
<section class="hb" data-hb>
  <div class="hb__bg" aria-hidden="true">
    <span class="hb__blob hb__blob--1"></span>
    <span class="hb__blob hb__blob--2"></span>
    <span class="hb__blob hb__blob--3"></span>
    <span class="hb__grain"></span>
  </div>

  <div class="page-width hb__grid">
    <div class="hb__content">
      {%- if section.settings.eyebrow != blank -%}<span class="hb__pill"><span class="hb__dot"></span>{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1 class="hb__title">{{ section.settings.heading_1 }} <span class="hb__shine">{{ section.settings.heading_highlight }}</span> {{ section.settings.heading_2 }}</h1>
      <div class="hb__text rte">{{ section.settings.text }}</div>
      <ul class="hb__chips">
        {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}><span>{{ block.settings.icon }}</span>{{ block.settings.label }}</li>{%- endfor -%}
      </ul>
      <div class="hb__ctas">
        <a class="hb__btn hb__btn--main" href="{{ url }}">
          <span>{{ section.settings.btn1_label }}</span>
          {%- if p != blank -%}
            <span class="hb__btn-price">{% if p.compare_at_price > p.price %}<s>{{ p.compare_at_price | money }}</s> {% endif %}{{ p.price | money }}</span>
          {%- endif -%}
        </a>
        {%- if section.settings.btn2_label != blank -%}<a class="hb__btn hb__btn--ghost" href="{{ section.settings.btn2_link }}">{{ section.settings.btn2_label }}</a>{%- endif -%}
      </div>
      {%- if section.settings.proof != blank -%}
        <p class="hb__proof"><span class="stars__icons" style="--pct:100%"></span> {{ section.settings.proof }}</p>
      {%- endif -%}
    </div>

    <div class="hb__stage" data-hb-stage>
      <div class="hb__halo" data-depth="0.15"></div>
      <svg class="hb__ring" viewBox="0 0 200 200" aria-hidden="true" data-depth="0.08">
        <defs><path id="hbCircle-{{ section.id }}" d="M100,100 m-82,0 a82,82 0 1,1 164,0 a82,82 0 1,1 -164,0"/></defs>
        <text><textPath href="#hbCircle-{{ section.id }}">{{ section.settings.ring_text }}</textPath></text>
      </svg>
      <div class="hb__product" data-depth="0.45">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.heading_highlight, class: 'hb__product-img' }}
        {%- else -%}
          <img class="hb__product-img" src="{{ section.settings.image_asset | asset_url }}" alt="{{ p.title | default: 'Brosse lymphatique visage' | escape }}" width="1000" height="793" fetchpriority="high">
        {%- endif -%}
        <span class="hb__shadow"></span>
      </div>

      {%- if section.settings.lifestyle != blank or section.settings.lifestyle_asset != blank -%}
        <figure class="hb__bubble" data-depth="0.7">
          {%- if section.settings.lifestyle != blank -%}
            {{ section.settings.lifestyle | image_url: width: 500 | image_tag: loading: 'lazy', alt: section.settings.lifestyle_label }}
          {%- else -%}
            <img src="{{ section.settings.lifestyle_asset | asset_url }}" alt="{{ section.settings.lifestyle_label | escape }}" width="500" height="500" loading="lazy">
          {%- endif -%}
          <figcaption>{{ section.settings.lifestyle_label }}</figcaption>
        </figure>
      {%- endif -%}

      {%- if p != blank and p.compare_at_price > p.price -%}
        {%- assign save = p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price | round -%}
        <div class="hb__tag" data-depth="0.9"><strong>-{{ save }} %</strong><span>{{ section.settings.tag_text }}</span></div>
      {%- endif -%}
      {%- if section.settings.badge != blank -%}
        <div class="hb__badge" data-depth="0.6">✦ {{ section.settings.badge }}</div>
      {%- endif -%}
      <span class="hb__orb hb__orb--1" data-depth="1.1"></span>
      <span class="hb__orb hb__orb--2" data-depth="0.5"></span>
      <span class="hb__orb hb__orb--3" data-depth="1.4"></span>
    </div>
  </div>

  <a class="hb__scroll" href="#MainContent-next" aria-label="Défiler"><span></span></a>
</section>
<span id="MainContent-next"></span>

<script>
  (function () {
    var root = document.querySelector('[data-hb]');
    if (!root || !window.matchMedia) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var layers = root.querySelectorAll('[data-depth]');
    var tx = 0, ty = 0, cx = 0, cy = 0, raf = null, sy = 0;
    function tick() {
      cx += (tx - cx) * 0.08; cy += (ty - cy) * 0.08;
      for (var i = 0; i < layers.length; i++) {
        var d = parseFloat(layers[i].getAttribute('data-depth')) || 0;
        layers[i].style.transform = 'translate3d(' + (cx * d * 28).toFixed(2) + 'px,' + (cy * d * 22 - sy * d * 0.12).toFixed(2) + 'px,0)';
      }
      if (Math.abs(tx - cx) > 0.001 || Math.abs(ty - cy) > 0.001) raf = requestAnimationFrame(tick); else raf = null;
    }
    function kick() { if (!raf) raf = requestAnimationFrame(tick); }
    if (window.matchMedia('(hover: hover)').matches) {
      root.addEventListener('mousemove', function (e) {
        var r = root.getBoundingClientRect();
        tx = (e.clientX - r.left) / r.width - 0.5; ty = (e.clientY - r.top) / r.height - 0.5; kick();
      });
      root.addEventListener('mouseleave', function () { tx = 0; ty = 0; kick(); });
    }
    window.addEventListener('scroll', function () { var y = window.scrollY; if (y < 900) { sy = y; tx += 0.0001; kick(); } }, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Bannière brosse 3D",
  "settings": [
    { "type": "product", "id": "product", "label": "Produit mis en avant" },
    { "type": "image_picker", "id": "image", "label": "Image produit détourée (PNG transparent)" },
    { "type": "text", "id": "image_asset", "label": "Ou image du thème (fichier assets)", "default": "brosse-detouree.png" },
    { "type": "image_picker", "id": "lifestyle", "label": "Photo du geste (bulle)" },
    { "type": "text", "id": "lifestyle_asset", "label": "Ou photo du thème (fichier assets)", "default": "brosse-geste-rond.jpg" },
    { "type": "text", "id": "lifestyle_label", "label": "Légende de la bulle", "default": "Le geste drainant" },
    { "type": "text", "id": "eyebrow", "label": "Pastille", "default": "Nouveau · Brosse lymphatique visage" },
    { "type": "text", "id": "heading_1", "label": "Titre – début", "default": "Réveillez" },
    { "type": "text", "id": "heading_highlight", "label": "Titre – mot en couleur", "default": "l’éclat" },
    { "type": "text", "id": "heading_2", "label": "Titre – fin", "default": "de votre visage" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>La brosse lymphatique en bois naturel et fibres ultra-douces : 3 minutes de massage drainant pour un teint frais et des traits visiblement reposés.</p>" },
    { "type": "text", "id": "btn1_label", "label": "Bouton principal", "default": "Je la veux" },
    { "type": "url", "id": "btn1_link", "label": "Lien (vide = produit)" },
    { "type": "text", "id": "btn2_label", "label": "Bouton secondaire", "default": "Voir le rituel" },
    { "type": "url", "id": "btn2_link", "label": "Lien secondaire" },
    { "type": "text", "id": "proof", "label": "Preuve sociale (uniquement chiffres réels)" },
    { "type": "text", "id": "ring_text", "label": "Texte circulaire", "default": "BROSSE LYMPHATIQUE ✦ BOIS NATUREL ✦ BIOVELA PARIS ✦ " },
    { "type": "text", "id": "badge", "label": "Badge flottant", "default": "Best-seller" },
    { "type": "text", "id": "tag_text", "label": "Texte sous la remise", "default": "offre de lancement" }
  ],
  "blocks": [
    { "type": "chip", "name": "Bénéfice", "limit": 4, "settings": [
      { "type": "text", "id": "icon", "label": "Symbole", "default": "✦" },
      { "type": "text", "id": "label", "label": "Texte", "default": "Teint frais" }
    ] }
  ],
  "presets": [{ "name": "Bannière brosse 3D", "blocks": [{ "type": "chip" }] }]
}
{% endschema %}
