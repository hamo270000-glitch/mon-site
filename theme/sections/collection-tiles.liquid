<section class="section">
  <div class="page-width">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="tiles" style="--cols: {{ section.blocks.size | at_most: 4 }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign url = block.settings.link
          if url == blank and c != blank
            assign url = c.url
          endif
          if url == blank
            assign url = routes.all_products_collection_url
          endif
        -%}
        <a class="tile" href="{{ url }}" {{ block.shopify_attributes }}>
          <div class="tile__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 750px) 33vw, 100vw', alt: block.settings.title }}
            {%- elsif block.settings.image_asset != blank -%}
              <img src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="900" height="1125">
            {%- elsif c != blank and c.featured_image -%}
              {{ c.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {%- endif -%}
          </div>
          <div class="tile__label">
            <strong>{{ block.settings.title }}</strong>
            {%- if block.settings.note != blank -%}<span>{{ block.settings.note }}</span>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Catégories",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Nos univers" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Choisissez votre rituel" }
  ],
  "max_blocks": 4,
  "blocks": [{ "type": "tile", "name": "Catégorie", "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_asset", "label": "Ou image du thème (fichier assets)" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Soins visage" },
    { "type": "text", "id": "note", "label": "Petit texte à droite", "default": "Voir tout" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "url", "id": "link", "label": "Ou lien" }
  ] }],
  "presets": [{ "name": "Catégories", "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }] }]
}
{% endschema %}
