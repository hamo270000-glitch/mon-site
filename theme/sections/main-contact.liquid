<section class="section">
  <div class="page-width page-content">
    <div class="section-head"><span class="eyebrow">Service client</span><h1>{{ page.title }}</h1><div class="rte">{{ page.content }}</div></div>
    {%- form 'contact', class: 'contact-form' -%}
      {%- if form.posted_successfully? -%}<p class="notice">{{ 'contact.success' | t }}</p>{%- endif -%}
      {{ form.errors | default_errors }}
      <div class="form-row">
        <input class="field" type="text" name="contact[name]" placeholder="{{ 'contact.name' | t }}" autocomplete="name">
        <input class="field" type="email" name="contact[email]" placeholder="Email" required autocomplete="email">
      </div>
      <input class="field" type="tel" name="contact[phone]" placeholder="{{ 'contact.phone' | t }}" autocomplete="tel">
      <textarea name="contact[body]" placeholder="{{ 'contact.message' | t }}" required></textarea>
      <button class="btn btn--primary" type="submit">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Formulaire de contact" }
{% endschema %}
